# Server only. Copy to .env.local; never use VITE_ for credentials.
DATABASE_URL=postgresql://portfolio:replace-me@localhost:5432/portfolio
OWNER_API_TOKEN=
MCP_API_TOKEN=
GENESIS_API_URL=http://127.0.0.1:3000
GENESIS_API_KEY=
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=384
# Optional local generation, independent from the embedding model/dimension.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
PUBLIC_ORIGIN=http://localhost:3100
PORT=3100

POSTGRES_PASSWORD=
KNOWLEDGE_API_URL=http://127.0.0.1:3100
GITHUB_WEBHOOK_SECRET=

# Private optional local speech worker; never VITE_ variables or public origins.
VOICE_WORKER_SOCKET=
VOICE_WORKER_TOKEN=
VOICE_WORKER_REVISION=small-cpu4-beam5-v4
VOICE_TTS_ORIGIN=
VOICE_TTS_TOKEN=
VOICE_TTS_APPROVED=false
