# Environment variables
# Copy to `.env` for local development. `.env` is git-ignored — never commit real keys.

# === Chatbot (server-side) ===
# Used by api/chat.js (Vercel Function) and by the Vite dev middleware.
# Not prefixed with VITE_, so it is never bundled into the browser.
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# === EVA backend (optional, preferred when reachable) ===
# Leave VITE_USE_EVA_BACKEND unset/false to use /api/chat directly.
VITE_USE_EVA_BACKEND=false
VITE_EVA_API_URL=

# Optional: point the widget at a different chat endpoint (default: /api/chat)
# VITE_CHAT_API_URL=/api/chat
